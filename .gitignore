# Python (backend)
backend/.venv/
**/__pycache__/
*.pyc

# Node (frontend)
frontend/node_modules/
frontend/dist/

# Local secrets -- contains the Mapbox token; keep frontend/.env.example
# checked in instead so a fresh clone knows what to set.
frontend/.env

# Logs
*.log

# Raw, unsimplified districts boundary (~300MB) -- the app only ever reads
# Pakistan_Districts.simplified.geojson (see backend/app.py); the raw file
# is source material, not something the running app needs, and exceeds
# GitHub's 100MB per-file limit.
boundaries/Pakistan_Districts.geojson

# Raw WGMS AMCE global dataset (~470MB, ~50MB zipped) -- source material for
# the 2020-2026 update merged into backend/data/glaciers.geojson's `pRecent`
# field (only 3 of ~19 region files are HKH-relevant); not something the
# running app reads directly.
wgms-amce-2026-02-10/
wgms-amce-2026-02-10.zip

# Raw GTN-G global region-boundary shapefile (world, both O1 and O2 levels)
# -- was source material for the since-removed RGI7 HKH glaciated-region
# layer; not something the running app reads.
rgi7_regions/

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
